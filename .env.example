# Copy this file to .env and fill in your own values. Never commit .env.

# Free Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Comma-separated fallback chains. The free tier allows only ~20 requests per day
# per model, so when one model's daily quota runs out the next one is used.

# Models that write the story (V1 game master, V2 narrator)
GEMINI_MODEL=gemini-3.6-flash,gemini-3.5-flash,gemini-3.8-flash,gemini-3.7-flash,gemini-3.1-flash-lite

# Small, fast models that turn player text into a structured action (V2 only)
GEMINI_PARSER_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite
