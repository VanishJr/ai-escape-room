# Copy this file to .env and fill in your own values. Never commit .env.

# Free Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model that writes the story (V1 game master, V2 narrator)
GEMINI_MODEL=gemini-3.6-flash

# Small, fast model that turns player text into a structured action (V2 only)
GEMINI_PARSER_MODEL=gemini-3.5-flash-lite
